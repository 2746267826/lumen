# The public URL used when generating share links. Set this to the address
# clients can actually reach (domain or LAN IP). Leave empty to derive it from
# the incoming request Host header.
LUMEN_PUBLIC_URL=https://lumen.example.com

LUMEN_ALLOW_REGISTRATION=true
LUMEN_RETENTION_DAYS=14

# Bytes. Defaults: 20 GiB per public share, 200 GiB per device-to-device transfer.
LUMEN_MAX_SHARE_BYTES=21474836480
LUMEN_MAX_TRANSFER_BYTES=214748364800
