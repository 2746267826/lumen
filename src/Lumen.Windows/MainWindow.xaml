<Window x:Class="Lumen.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:infra="clr-namespace:Lumen.Windows.Infrastructure"
        Title="Lumen · 流明互传"
        Width="1240" Height="820" MinWidth="1050" MinHeight="690"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}" TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                        GlassFrameThickness="0" CornerRadius="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="Margin" Value="0,0,0,7" />
    </Style>
    <Style x:Key="FieldHint" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,5,0,0" />
    </Style>
    <Style x:Key="TransferCardButton" TargetType="{x:Type Button}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Root" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="18,16" Margin="0,0,0,10">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="BorderBrush" Value="#3A4362" />
                <Setter TargetName="Root" Property="Background" Value="#141929" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#181E31" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="MetricLabel" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
      <Setter Property="Margin" Value="0,0,0,5" />
    </Style>
    <Style x:Key="DetailValue" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="StatusPill" TargetType="{x:Type Border}">
      <Setter Property="Background" Value="#171D2C" />
      <Setter Property="BorderBrush" Value="#2A3247" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style x:Key="NavBadge" TargetType="{x:Type Border}">
      <Setter Property="Background" Value="#27224A" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <Grid x:Name="RootGrid" Background="{StaticResource BgBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="44" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid x:Name="TitleBar" Grid.Row="0" Background="#0B0E17"
          MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="236" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
        <Border Width="22" Height="22" CornerRadius="7" Background="{StaticResource AccentGradient}">
          <TextBlock Text="L" Foreground="#0B0D14" FontSize="12" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="LUMEN" Margin="9,0,0,0" FontSize="11" FontWeight="SemiBold"
                   Foreground="#DCE1F2" VerticalAlignment="Center" />
        <TextBlock Text="流明互传" Margin="7,0,0,0" FontSize="10.5"
                   Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                  VerticalAlignment="Center">
        <Ellipse Width="5" Height="5" Fill="{StaticResource GreenBrush}" Margin="0,0,7,0" />
        <TextBlock Text="LOCAL FIRST · ADAPTIVE RELAY" FontSize="9.5" Foreground="#6F7891"
                   FontWeight="SemiBold" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button Style="{StaticResource WindowButton}" Content="&#xE921;" ToolTip="最小化"
                Click="MinimizeButton_Click" />
        <Button Style="{StaticResource WindowButton}" Content="&#xE922;" ToolTip="最大化 / 还原"
                Click="MaximizeButton_Click" />
        <Button Style="{StaticResource WindowButtonClose}" Content="&#xE8BB;" ToolTip="关闭"
                Click="CloseButton_Click" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="236" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
              BorderBrush="#1A2030" BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Margin="18,22,18,16">
            <TextBlock Text="传输中心" FontSize="10" Foreground="{StaticResource DimBrush}"
                       FontWeight="SemiBold" Margin="9,0,0,10" />
            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                         IsChecked="{Binding IsDevicesPage, Mode=OneWay}"
                         Command="{Binding NavigateCommand}" CommandParameter="devices">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="26" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE772;" FontSize="15"
                           HorizontalAlignment="Left" />
                <TextBlock Grid.Column="1" Text="附近设备" VerticalAlignment="Center" />
                <Border Grid.Column="2" Style="{StaticResource NavBadge}"
                        Visibility="{Binding OnlineDeviceCount, Converter={StaticResource CountToVis}}">
                  <TextBlock Text="{Binding OnlineDeviceCount}" FontSize="10" Foreground="#B9B1FF" />
                </Border>
              </Grid>
            </RadioButton>
            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                         IsChecked="{Binding IsTransfersPage, Mode=OneWay}"
                         Command="{Binding NavigateCommand}" CommandParameter="transfers">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="26" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE81C;" FontSize="15"
                           HorizontalAlignment="Left" />
                <TextBlock Grid.Column="1" Text="传输记录" VerticalAlignment="Center" />
                <Border Grid.Column="2" Style="{StaticResource NavBadge}"
                        Visibility="{Binding ActiveTransferCount, Converter={StaticResource CountToVis}}">
                  <TextBlock Text="{Binding ActiveTransferCount}" FontSize="10" Foreground="#B9B1FF" />
                </Border>
              </Grid>
            </RadioButton>
            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                         IsChecked="{Binding IsSharesPage, Mode=OneWay}"
                         Command="{Binding NavigateCommand}" CommandParameter="shares">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="26" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE71B;" FontSize="15"
                           HorizontalAlignment="Left" />
                <TextBlock Grid.Column="1" Text="分享链接" VerticalAlignment="Center" />
                <Border Grid.Column="2" Style="{StaticResource NavBadge}"
                        Visibility="{Binding ShareCount, Converter={StaticResource CountToVis}}">
                  <TextBlock Text="{Binding ShareCount}" FontSize="10" Foreground="#B9B1FF" />
                </Border>
              </Grid>
            </RadioButton>
            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                         IsChecked="{Binding IsSettingsPage, Mode=OneWay}"
                         Command="{Binding NavigateCommand}" CommandParameter="settings">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="26" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE713;" FontSize="15"
                           HorizontalAlignment="Left" />
                <TextBlock Grid.Column="1" Text="设备与连接" VerticalAlignment="Center" />
              </Grid>
            </RadioButton>
          </StackPanel>

          <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="14,0,14,14">
            <Border Style="{StaticResource SoftCard}" Margin="0,0,0,10">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource AvatarGradient}">
                    <TextBlock Text="{Binding AccountInitial}" Foreground="#0B0D14"
                               FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="10,1,0,0">
                    <TextBlock Text="{Binding AccountLabel}" FontSize="12.5" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding AccountSubLabel}" Style="{StaticResource CaptionText}"
                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
                <Border Style="{StaticResource Divider}" Margin="0,11,0,10" />
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="6" Height="6" Fill="{Binding ServerStatusColor, Converter={StaticResource StringToBrush}}"
                           Margin="0,0,7,0" />
                  <TextBlock Text="{Binding ServerStatus}" FontSize="10.5"
                             Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                  <Ellipse Width="6" Height="6" Fill="{Binding LanStatusColor, Converter={StaticResource StringToBrush}}"
                           Margin="0,0,7,0" />
                  <TextBlock Text="{Binding LanStatus}" FontSize="10.5"
                             Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </StackPanel>
            </Border>
            <TextBlock Text="LUMEN 1.0 · NATIVE WPF" FontSize="8.5" Foreground="#4F5871"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="34,22,34,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{Binding PageTitle}" Style="{StaticResource DisplayTitle}" />
            <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource MutedText}"
                       Margin="0,5,0,0" FontSize="12.5" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Style="{StaticResource StatusPill}" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Fill="{Binding LanStatusColor, Converter={StaticResource StringToBrush}}"
                         Margin="0,0,7,0" />
                <TextBlock Text="{Binding LanStatus}" FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource StatusPill}" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Fill="{Binding ServerStatusColor, Converter={StaticResource StringToBrush}}"
                         Margin="0,0,7,0" />
                <TextBlock Text="{Binding ServerStatus}" FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
              </StackPanel>
            </Border>
            <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="刷新"
                    Command="{Binding RefreshCommand}" />
          </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsDevicesPage, Converter={StaticResource BoolToVis}}">
          <StackPanel Margin="34,0,34,34">
            <Border CornerRadius="22" Padding="28" Background="{StaticResource HeroGradient}"
                    BorderBrush="#2E3550" BorderThickness="1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="AUTO ROUTING" FontSize="9.5" FontWeight="Bold" Foreground="#8F86FF" />
                  <TextBlock Text="文件，走最近的路。" Style="{StaticResource DisplayTitle}"
                             FontSize="30" Margin="0,9,0,0" />
                  <TextBlock Text="同一局域网优先直连；跨网络时自动切换到服务器中转。每一条路线、每一个分块都可追踪。"
                             Style="{StaticResource MutedText}" MaxWidth="560" HorizontalAlignment="Left"
                             Margin="0,9,0,0" FontSize="12.5" />
                  <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Border Style="{StaticResource Chip}" Margin="0,0,8,0">
                      <TextBlock Text="局域网直连" FontSize="10.5" Foreground="#B8F2E8" />
                    </Border>
                    <Border Style="{StaticResource Chip}" Margin="0,0,8,0">
                      <TextBlock Text="服务器中转" FontSize="10.5" Foreground="#D0CAFF" />
                    </Border>
                    <Border Style="{StaticResource Chip}">
                      <TextBlock Text="IPv4 / IPv6" FontSize="10.5" Foreground="#C4CCE0" />
                    </Border>
                  </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Margin="24,0,0,0" CornerRadius="18" Background="#10141F"
                        BorderBrush="#2B3450" BorderThickness="1" Padding="18">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="在线设备" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding OnlineDeviceCount}" Style="{StaticResource MetricValue}" />
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="局域网可见" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding LanDeviceCount}" Style="{StaticResource MetricValue}" />
                      </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource Divider}" />
                    <Grid Grid.Row="1" Margin="0,18,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="中转在线" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding RelayDeviceCount}" Style="{StaticResource MetricValue}" FontSize="21" />
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="活跃传输" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding ActiveTransferCount}" Style="{StaticResource MetricValue}" FontSize="21" />
                      </StackPanel>
                    </Grid>
                  </Grid>
                </Border>
              </Grid>
            </Border>

            <Grid Margin="0,20,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,10,0">
                <StackPanel>
                  <TextBlock Text="直连服务" Style="{StaticResource MetricLabel}" />
                  <TextBlock Text="{Binding DirectStatus}" FontSize="12" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,10,0">
                <StackPanel>
                  <TextBlock Text="本机 IPv4" Style="{StaticResource MetricLabel}" />
                  <TextBlock Text="{Binding LocalIpv4}" FontSize="12" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16" Margin="0,0,10,0">
                <StackPanel>
                  <TextBlock Text="本机 IPv6" Style="{StaticResource MetricLabel}" />
                  <TextBlock Text="{Binding LocalIpv6}" FontSize="12" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>
              <Border Grid.Column="3" Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                  <TextBlock Text="服务器延迟" Style="{StaticResource MetricLabel}" />
                  <TextBlock FontSize="12" FontWeight="SemiBold">
                    <Run Text="{Binding LatencyMs, Mode=OneWay}" /><Run Text=" ms" />
                  </TextBlock>
                </StackPanel>
              </Border>
            </Grid>

            <Grid Margin="0,27,0,13">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="可用设备" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{Binding OnlineDeviceCount, StringFormat='{}{0} 台在线'}"
                           Style="{StaticResource MutedText}" Margin="10,4,0,0" />
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE72C;" FontSize="13" />
                  <TextBlock Text="刷新发现" Margin="7,0,0,0" />
                </StackPanel>
              </Button>
            </Grid>

            <ItemsControl ItemsSource="{Binding Devices}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="18">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="48" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="46" Height="46" CornerRadius="15" Background="{StaticResource AvatarGradient}">
                          <TextBlock Text="{Binding Initial}" Foreground="#0B0D14" FontSize="18"
                                     FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,1,0,0">
                          <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding ModelLabel}" Style="{StaticResource CaptionText}"
                                     Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding PlatformGlyph}" Style="{StaticResource IconGlyph}"
                                     FontSize="18" Foreground="#73809E" HorizontalAlignment="Right" />
                          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Ellipse Width="6" Height="6" Margin="0,0,5,0"
                                     Fill="{Binding StatusColor, Converter={StaticResource StringToBrush}}" />
                            <TextBlock Text="{Binding StatusLabel}" FontSize="9"
                                       Foreground="{StaticResource MutedBrush}" />
                          </StackPanel>
                        </StackPanel>
                      </Grid>
                      <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
                        <Border Style="{StaticResource Chip}" Margin="0,0,6,0">
                          <TextBlock Text="{Binding PreferredRouteLabel}" FontSize="9.5" Foreground="#CDBFFF" />
                        </Border>
                        <Border Style="{StaticResource Chip}" Margin="0,0,6,0">
                          <TextBlock Text="{Binding IpFamilyLabel}" FontSize="9.5" Foreground="#AEB8CF" />
                        </Border>
                        <Border Style="{StaticResource Chip}">
                          <TextBlock Text="{Binding LastSeenLabel}" FontSize="9.5" Foreground="#8F99B2" />
                        </Border>
                      </StackPanel>
                      <TextBlock Grid.Row="2" Text="{Binding AddressSummary}" Style="{StaticResource CaptionText}"
                                 FontFamily="{StaticResource MonoFont}" Margin="0,12,0,0"
                                 TextTrimming="CharacterEllipsis" />
                      <Grid Grid.Row="3" Margin="0,17,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SourceLabel}" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Margin="4,0,0,0"
                                Command="{Binding DataContext.SendImageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" ToolTip="发送图片" IsEnabled="{Binding CanSend}">
                          <TextBlock Style="{StaticResource IconGlyph}" Text="&#xEB9F;" FontSize="13" />
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Margin="2,0,0,0"
                                Command="{Binding DataContext.SendTextCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" ToolTip="发送文字" IsEnabled="{Binding CanSend}">
                          <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8A5;" FontSize="13" />
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource PrimaryButton}"
                                Padding="14,8" Margin="8,0,0,0" FontSize="11.5"
                                Command="{Binding DataContext.SendFilesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" IsEnabled="{Binding CanSend}">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE898;" FontSize="12"
                                       Foreground="#0B0D14" />
                            <TextBlock Text="发送" Margin="6,0,0,0" Foreground="#0B0D14" FontWeight="SemiBold" />
                          </StackPanel>
                        </Button>
                      </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Visibility="{Binding HasNoDevices, Converter={StaticResource BoolToVis}}"
                    Padding="34" Margin="0,0,0,12">
              <StackPanel HorizontalAlignment="Center">
                <Border Width="56" Height="56" CornerRadius="18" Background="#161C2E">
                  <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE772;" FontSize="23"
                             Foreground="#7E89A7" />
                </Border>
                <TextBlock Text="还没有发现设备" Style="{StaticResource SectionTitle}" Margin="0,15,0,0"
                           HorizontalAlignment="Center" />
                <TextBlock Text="在另一台设备打开 Lumen；同账号设备会自动上线，同一局域网内的设备也会自动发现。"
                           Style="{StaticResource MutedText}" MaxWidth="430" TextAlignment="Center"
                           Margin="0,7,0,0" />
                <Button Style="{StaticResource SecondaryButton}" Content="刷新设备"
                        Command="{Binding RefreshCommand}" HorizontalAlignment="Center" Margin="0,16,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="34,0,34,26"
              Visibility="{Binding IsTransfersPage, Converter={StaticResource BoolToVis}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <RadioButton Style="{StaticResource FilterChip}" GroupName="TransferFilter" Content="全部"
                           IsChecked="{Binding IsAllFilter, Mode=OneWay}"
                           Command="{Binding SetFilterCommand}" CommandParameter="all" />
              <RadioButton Style="{StaticResource FilterChip}" GroupName="TransferFilter" Content="发送"
                           IsChecked="{Binding IsSentFilter, Mode=OneWay}"
                           Command="{Binding SetFilterCommand}" CommandParameter="out" />
              <RadioButton Style="{StaticResource FilterChip}" GroupName="TransferFilter" Content="接收"
                           IsChecked="{Binding IsReceivedFilter, Mode=OneWay}"
                           Command="{Binding SetFilterCommand}" CommandParameter="in" />
              <RadioButton Style="{StaticResource FilterChip}" GroupName="TransferFilter" Content="局域网"
                           IsChecked="{Binding IsLanFilter, Mode=OneWay}"
                           Command="{Binding SetFilterCommand}" CommandParameter="lan" />
              <RadioButton Style="{StaticResource FilterChip}" GroupName="TransferFilter" Content="服务器中转"
                           IsChecked="{Binding IsRelayFilter, Mode=OneWay}"
                           Command="{Binding SetFilterCommand}" CommandParameter="relay" />
