                <TextBlock><Run Text="{Binding TransferCount, Mode=OneWay}" /><Run Text=" 条记录" /></TextBlock>
              </Border>
            </StackPanel>
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding TransfersView}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource TransferCardButton}"
                            Command="{Binding DataContext.OpenTransferCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="48" />
                          <ColumnDefinition Width="1.7*" />
                          <ColumnDefinition Width="1.2*" />
                          <ColumnDefinition Width="1.35*" />
                          <ColumnDefinition Width="114" />
                          <ColumnDefinition Width="20" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="14" Background="#181F32" VerticalAlignment="Top">
                          <TextBlock Style="{StaticResource IconGlyph}" Text="{Binding KindGlyph}"
                                     FontSize="18" Foreground="#A69CFF" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,12,0">
                          <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis" />
                          <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="{Binding DirectionLabel}" FontSize="10" Foreground="#8B95AE" />
                            <TextBlock Text=" · " FontSize="10" Foreground="#4B5470" />
                            <TextBlock Text="{Binding PeerLabel}" FontSize="10" Foreground="#8B95AE"
                                       TextTrimming="CharacterEllipsis" MaxWidth="180" />
                          </StackPanel>
                          <TextBlock Text="{Binding TimeLabel}" Style="{StaticResource CaptionText}" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,2,12,0">
                          <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource Chip}" Margin="0,0,6,0">
                              <TextBlock Text="{Binding RouteShortLabel}" FontSize="9" Foreground="#CFC4FF" />
                            </Border>
                            <Border Style="{StaticResource Chip}">
                              <TextBlock Text="{Binding IpLabel}" FontSize="9" Foreground="#AAB4CC" />
                            </Border>
                          </StackPanel>
                          <TextBlock Text="{Binding AddressLabel}" Style="{StaticResource CaptionText}"
                                     Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="0,2,16,0">
                          <ProgressBar Style="{StaticResource ProgressTrack}" Height="5"
                                       Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" />
                          <Grid Margin="0,7,0,0">
                            <TextBlock Text="{Binding TransferredLabel}" FontSize="10" Foreground="#8C96AF" />
                            <TextBlock Text="{Binding SpeedLabel}" FontSize="10" Foreground="#6F7A94"
                                       HorizontalAlignment="Right" />
                          </Grid>
                          <TextBlock Text="{Binding ChunkLabel}" Style="{StaticResource CaptionText}"
                                     Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                          <Border Style="{StaticResource StatusPill}" HorizontalAlignment="Left" Background="#151B2A">
                            <StackPanel Orientation="Horizontal">
                              <Ellipse Width="5" Height="5" Margin="0,0,6,0"
                                       Fill="{Binding StatusColor, Converter={StaticResource StringToBrush}}" />
                              <TextBlock Text="{Binding StatusLabel}" FontSize="9.5"
                                         Foreground="{Binding StatusColor, Converter={StaticResource StringToBrush}}" />
                            </StackPanel>
                          </Border>
                          <TextBlock Text="{Binding ProgressText}" FontSize="10" Foreground="#69738C"
                                     Margin="0,7,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="5" Style="{StaticResource IconGlyph}" Text="&#xE76C;"
                                   FontSize="11" Foreground="#5D6782" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Style="{StaticResource Card}" Padding="36" Margin="0,0,0,12"
                      Visibility="{Binding HasNoTransfers, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center">
                  <Border Width="56" Height="56" CornerRadius="18" Background="#161C2E">
                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE81C;" FontSize="23" Foreground="#7E89A7" />
                  </Border>
                  <TextBlock Text="还没有传输记录" Style="{StaticResource SectionTitle}" Margin="0,15,0,0"
                             HorizontalAlignment="Center" />
                  <TextBlock Text="从“附近设备”选择设备，发送文件、图片或文字。"
                             Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,7,0,0" />
                  <Button Style="{StaticResource SecondaryButton}" Content="去发送"
                          Command="{Binding NavigateCommand}" CommandParameter="devices"
                          HorizontalAlignment="Center" Margin="0,16,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsSharesPage, Converter={StaticResource BoolToVis}}">
          <StackPanel Margin="34,0,34,34">
            <Border CornerRadius="20" Padding="24" Background="#13182A"
                    BorderBrush="#28314A" BorderThickness="1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="PUBLIC LINKS" FontSize="9" FontWeight="Bold" Foreground="#8F86FF" />
                  <TextBlock Text="把文件交给任何人，而不安装应用。" Style="{StaticResource SectionTitle}"
                             FontSize="19" Margin="0,7,0,0" />
                  <TextBlock Text="分享链接可设置有效期、访问密码和下载次数上限；到期后自动失效。"
                             Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                          Command="{Binding CreateTextShareCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8A5;" FontSize="12" />
                      <TextBlock Text="文字分享" Margin="7,0,0,0" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource PrimaryButton}" Command="{Binding CreateShareFileCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE710;" FontSize="12"
                                 Foreground="#0B0D14" />
                      <TextBlock Text="分享文件" Margin="7,0,0,0" Foreground="#0B0D14" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
            <Grid Margin="0,25,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="我的分享" Style="{StaticResource SectionTitle}" />
              <Button Grid.Column="1" Style="{StaticResource GhostButton}"
                      Command="{Binding RefreshSharesCommand}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE72C;" FontSize="12" />
                  <TextBlock Text="刷新" Margin="6,0,0,0" />
                </StackPanel>
              </Button>
            </Grid>
            <ItemsControl ItemsSource="{Binding Shares}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="1.7*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border Width="44" Height="44" CornerRadius="14" Background="#181F32">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="{Binding KindGlyph}"
                                   FontSize="18" Foreground="#96E6DB" />
                      </Border>
                      <StackPanel Grid.Column="1" Margin="12,0,12,0">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Url}" Style="{StaticResource CaptionText}"
                                   FontFamily="{StaticResource MonoFont}" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding CreatedLabel}" Style="{StaticResource CaptionText}"
                                   Margin="0,4,0,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Margin="0,2,12,0">
                        <StackPanel Orientation="Horizontal">
                          <Border Style="{StaticResource Chip}" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Style="{StaticResource IconGlyph}" Text="{Binding ProtectionGlyph}"
                                         FontSize="9" Foreground="#C8BFFF" />
                              <TextBlock Text="{Binding ProtectionLabel}" FontSize="9" Margin="5,0,0,0"
                                         Foreground="#C8BFFF" />
                            </StackPanel>
                          </Border>
                          <Border Style="{StaticResource Chip}">
                            <TextBlock Text="{Binding SizeLabel}" FontSize="9" Foreground="#AAB4CC" />
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding DownloadLabel}" Style="{StaticResource CaptionText}"
                                   Margin="0,8,0,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusLabel}" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{Binding StatusColor, Converter={StaticResource StringToBrush}}" />
                        <TextBlock Text="{Binding ExpiryLabel}" Style="{StaticResource CaptionText}" Margin="0,5,0,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="复制链接"
                                Command="{Binding DataContext.CopyShareUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" ToolTip="打开链接"
                                Command="{Binding DataContext.OpenShareUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                        <Button Style="{StaticResource DangerGhostButton}" Content="撤销" FontSize="10.5"
                                Padding="8,6"
                                Command="{Binding DataContext.RevokeShareCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Style="{StaticResource Card}" Padding="36"
                    Visibility="{Binding HasNoShares, Converter={StaticResource BoolToVis}}">
              <StackPanel HorizontalAlignment="Center">
                <Border Width="56" Height="56" CornerRadius="18" Background="#161C2E">
                  <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE71B;" FontSize="23" Foreground="#7E89A7" />
                </Border>
                <TextBlock Text="还没有分享链接" Style="{StaticResource SectionTitle}" Margin="0,15,0,0"
                           HorizontalAlignment="Center" />
                <TextBlock Text="绑定服务器后，可以把任意文件或文字变成带密码保护的公开链接。"
                           Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,7,0,0" />
                <Button Style="{StaticResource SecondaryButton}" Content="去绑定服务器"
                        Command="{Binding NavigateCommand}" CommandParameter="settings"
                        HorizontalAlignment="Center" Margin="0,16,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVis}}">
          <Grid Margin="34,0,34,34">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.15*" />
              <ColumnDefinition Width="0.85*" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,14,0">
              <Border Style="{StaticResource Card}" Padding="22">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="服务器绑定" Style="{StaticResource SectionTitle}" />
                      <TextBlock Text="同账号设备上线后自动出现在附近设备列表。" Style="{StaticResource CaptionText}"
                                 Margin="0,4,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource StatusPill}" VerticalAlignment="Top">
                      <StackPanel Orientation="Horizontal">
                        <Ellipse Width="5" Height="5" Margin="0,0,6,0"
                                 Fill="{Binding ServerStatusColor, Converter={StaticResource StringToBrush}}" />
                        <TextBlock Text="{Binding ServerStatus}" FontSize="9.5"
                                   Foreground="{StaticResource MutedBrush}" />
                      </StackPanel>
                    </Border>
                  </Grid>
                  <StackPanel Visibility="{Binding IsLoggedIn, Converter={StaticResource InverseBoolToVis}}"
                              Margin="0,20,0,0">
                    <TextBlock Text="服务器地址" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource DarkTextBox}" Margin="0,0,0,13"
                             Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" />
                    <Grid Margin="0,0,0,13">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="用户名" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource DarkTextBox}"
                                 Text="{Binding UsernameInput, UpdateSourceTrigger=PropertyChanged}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="显示名称" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource DarkTextBox}"
                                 Text="{Binding DisplayNameInput, UpdateSourceTrigger=PropertyChanged}" />
                      </StackPanel>
                    </Grid>
                    <TextBlock Text="密码" Style="{StaticResource FieldLabel}" />
                    <PasswordBox Style="{StaticResource DarkPasswordBox}" Margin="0,0,0,15"
                                 infra:PasswordBoxHelper.Monitor="True"
                                 infra:PasswordBoxHelper.Password="{Binding PasswordInput, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal">
                      <Button Style="{StaticResource PrimaryButton}" Content="登录并连接"
                              Command="{Binding ConnectCommand}" IsEnabled="{Binding IsNotAuthenticating}" />
                      <Button Style="{StaticResource SecondaryButton}" Content="创建账户"
                              Command="{Binding RegisterCommand}" IsEnabled="{Binding IsNotAuthenticating}"
                              Margin="9,0,0,0" />
                      <TextBlock Text="正在连接…" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                 Margin="10,0,0,0"
                                 Visibility="{Binding IsAuthenticating, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <TextBlock Text="账户仅用于绑定设备和服务器中转；局域网直连不依赖服务器。"
                               Style="{StaticResource FieldHint}" />
                  </StackPanel>
                  <Grid Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}"
                        Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="44" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="13" Background="{StaticResource AvatarGradient}">
                      <TextBlock Text="{Binding AccountInitial}" Foreground="#0B0D14" FontWeight="Bold"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,1,0,0">
                      <TextBlock Text="{Binding AccountLabel}" FontSize="14" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding AccountSubLabel}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                      <TextBlock Text="{Binding ServerUrlLabel}" Style="{StaticResource CaptionText}"
                                 FontFamily="{StaticResource MonoFont}" Margin="0,5,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource DangerGhostButton}" Content="退出账户"
                            Command="{Binding LogoutCommand}" VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Padding="22" Margin="0,14,0,0">
                <StackPanel>
                  <TextBlock Text="本机设置" Style="{StaticResource SectionTitle}" />
                  <TextBlock Text="设备名会显示在对方的设备列表中。" Style="{StaticResource CaptionText}"
                             Margin="0,4,0,0" />
                  <TextBlock Text="设备名称" Style="{StaticResource FieldLabel}" Margin="0,17,0,7" />
                  <TextBox Style="{StaticResource DarkTextBox}"
                           Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Text="接收目录" Style="{StaticResource FieldLabel}" Margin="0,14,0,7" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource DarkTextBox}" Margin="0,0,8,0"
                             Text="{Binding ReceiveDirectory, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="选择"
                            Command="{Binding ChooseReceiveFolderCommand}" />
                  </Grid>
                  <TextBlock Text="分块大小" Style="{StaticResource FieldLabel}" Margin="0,14,0,7" />
                  <ComboBox ItemsSource="{Binding ChunkOptions}" DisplayMemberPath="Label"
                            SelectedItem="{Binding SelectedChunkSize}" />
                  <TextBlock Text="{Binding ChunkDetailLabel}" Style="{StaticResource FieldHint}" />
                  <StackPanel Orientation="Horizontal" Margin="0,17,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Content="保存设置"
                            Command="{Binding SaveSettingsCommand}" />
                    <Button Style="{StaticResource GhostButton}" Content="打开接收目录"
                            Command="{Binding OpenFolderCommand}" Margin="6,0,0,0" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <Border Style="{StaticResource Card}" Padding="22">
                <StackPanel>
                  <Grid>
                    <TextBlock Text="网络诊断" Style="{StaticResource SectionTitle}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;"
                            HorizontalAlignment="Right" Command="{Binding RefreshCommand}" />
                  </Grid>
                  <Border Style="{StaticResource Divider}" Margin="0,14,0,12" />
                  <Grid Margin="0,0,0,11">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="86" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="局域网发现" Style="{StaticResource CaptionText}" />
                    <TextBlock Grid.Column="1" Text="{Binding DiscoveryStatus}" Style="{StaticResource DetailValue}"
                               FontSize="11" TextAlignment="Right" />
                  </Grid>
                  <Grid Margin="0,0,0,11">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="86" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="直连监听" Style="{StaticResource CaptionText}" />
                    <TextBlock Grid.Column="1" Text="{Binding DirectStatus}" Style="{StaticResource DetailValue}"
                               FontSize="11" TextAlignment="Right" />
                  </Grid>
                  <Grid Margin="0,0,0,11">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="86" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="IPv4" Style="{StaticResource CaptionText}" />
                    <TextBlock Grid.Column="1" Text="{Binding LocalIpv4}" Style="{StaticResource DetailValue}"
                               FontFamily="{StaticResource MonoFont}" FontSize="10.5" TextAlignment="Right" />
                  </Grid>
                  <Grid Margin="0,0,0,11">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="86" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="IPv6" Style="{StaticResource CaptionText}" />
                    <TextBlock Grid.Column="1" Text="{Binding LocalIpv6}" Style="{StaticResource DetailValue}"
                               FontFamily="{StaticResource MonoFont}" FontSize="10.5" TextAlignment="Right" />
                  </Grid>
                  <Grid Margin="0,0,0,11">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="86" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="设备 ID" Style="{StaticResource CaptionText}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                      <TextBlock Text="{Binding DeviceIdShort}" Style="{StaticResource DetailValue}"
                                 FontFamily="{StaticResource MonoFont}" FontSize="10.5" />
                      <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" Width="24" Height="24"
                              Command="{Binding CopyDeviceIdCommand}" />
                    </StackPanel>
                  </Grid>
                  <Border Style="{StaticResource Divider}" Margin="0,4,0,10" />
                  <ItemsControl ItemsSource="{Binding LocalAddresses}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,0,0,6">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Border Background="#182033" CornerRadius="6" Padding="4,2">
                            <TextBlock Text="{Binding Family}" FontSize="8.5" Foreground="#8E9AB6" />
                          </Border>
                          <TextBlock Grid.Column="1" Text="{Binding Address}" FontFamily="{StaticResource MonoFont}"
                                     FontSize="10.5" Foreground="#B9C2D7" Margin="8,0,8,0"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="2" Text="{Binding InterfaceName}" Style="{StaticResource CaptionText}"
                                     MaxWidth="100" TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Style="{StaticResource GhostButton}" Content="打开应用数据目录"
                          Command="{Binding OpenDataFolderCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Padding="22" Margin="0,14,0,0">
                <StackPanel>
                  <TextBlock Text="路线说明" Style="{StaticResource SectionTitle}" />
                  <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Border Width="34" Height="34" CornerRadius="10" Background="#172521">
                      <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE968;" FontSize="15"
                                 Foreground="#71E5CE" />
                    </Border>
                    <StackPanel Margin="11,0,0,0">
                      <TextBlock Text="局域网直连" FontWeight="SemiBold" FontSize="12" />
                      <TextBlock Text="同一网络内直接传输，不经过服务器，速度取决于 Wi-Fi / 网线。"
                                 Style="{StaticResource CaptionText}" Margin="0,3,0,0" MaxWidth="260" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                    <Border Width="34" Height="34" CornerRadius="10" Background="#201E32">
                      <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE753;" FontSize="15"
                                 Foreground="#B5A9FF" />
                    </Border>
                    <StackPanel Margin="11,0,0,0">
                      <TextBlock Text="服务器中转" FontWeight="SemiBold" FontSize="12" />
                      <TextBlock Text="跨网络时通过 Docker 服务端暂存并转发；支持 IPv4、IPv6 和服务端反代。"
                                 Style="{StaticResource CaptionText}" Margin="0,3,0,0" MaxWidth="260" />
                    </StackPanel>
                  </StackPanel>
                  <Border Style="{StaticResource SoftCard}" Margin="0,18,0,0">
                    <TextBlock Text="安全提示：局域网直连需要双方确认；服务器中转内容会在磁盘暂存，默认 14 天后清理。公开分享请使用密码和较短有效期。"
                               Style="{StaticResource FieldHint}" FontSize="10.5" Margin="0" />
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Grid>
    </Grid>

    <Grid Grid.RowSpan="2" Panel.ZIndex="80" Background="#B3050710"
          Visibility="{Binding IsInviteOpen, Converter={StaticResource BoolToVis}}">
      <Border Width="500" CornerRadius="24" Background="#121725" BorderBrush="#2B344F"
              BorderThickness="1" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center"
              Effect="{StaticResource CardShadow}">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Width="54" Height="54" CornerRadius="17" Background="{StaticResource AvatarGradient}">
              <TextBlock Text="{Binding PendingInvite.PeerInitial}" Foreground="#0B0D14" FontSize="21"
                         FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="14,3,0,0">
              <TextBlock Text="{Binding PendingInvite.PeerName}" Style="{StaticResource SectionTitle}" FontSize="18" />
              <TextBlock Text="想向你发送" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
            </StackPanel>
          </StackPanel>
          <Border Style="{StaticResource SoftCard}" Margin="0,22,0,0" Padding="16">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Width="42" Height="42" CornerRadius="13" Background="#1D2638">
                <TextBlock Style="{StaticResource IconGlyph}" Text="{Binding PendingInvite.KindGlyph}"
                           FontSize="18" Foreground="#B3A8FF" />
              </Border>
              <StackPanel Grid.Column="1" Margin="11,0,10,0">
                <TextBlock Text="{Binding PendingInvite.Name}" FontSize="13" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding PendingInvite.SizeLabel}" Style="{StaticResource CaptionText}"
                           Margin="0,4,0,0" />
              </StackPanel>
              <Border Grid.Column="2" Style="{StaticResource Chip}" VerticalAlignment="Center">
                <TextBlock Text="{Binding PendingInvite.RouteShortLabel}" FontSize="9" Foreground="#C9C0FF" />
              </Border>
            </Grid>
          </Border>
          <TextBlock Text="{Binding PendingInvite.ConnectionDetail}" Style="{StaticResource CaptionText}"
                     Margin="0,12,0,0" />
          <Grid Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource SecondaryButton}" Content="拒绝" Height="42" Margin="0,0,6,0"
                    Command="{Binding DeclineInviteCommand}" />
            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="接受传输" Height="42"
                    Margin="6,0,0,0" Command="{Binding AcceptInviteCommand}" />
          </Grid>
          <TextBlock Text="接受后才会开始接收内容 · 邀请 2 分钟内有效" Style="{StaticResource CaptionText}"
                     HorizontalAlignment="Center" Margin="0,13,0,0" />
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.RowSpan="2" Panel.ZIndex="82" Background="#B3050710"
          Visibility="{Binding IsComposeOpen, Converter={StaticResource BoolToVis}}">
      <Border Width="560" CornerRadius="24" Background="#121725" BorderBrush="#2B344F"
              BorderThickness="1" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center"
              Effect="{StaticResource CardShadow}">
        <StackPanel>
          <Grid>
            <StackPanel>
              <TextBlock Text="发送文字" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="{Binding ComposeTargetLabel, StringFormat='发送到 {0}'}"
                         Style="{StaticResource MutedText}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Style="{StaticResource IconButton}" Content="&#xE8BB;"
                    Command="{Binding CloseComposeCommand}" HorizontalAlignment="Right" />
          </Grid>
          <TextBox Style="{StaticResource DarkTextBox}" Margin="0,20,0,8"
                   Text="{Binding ComposeText, UpdateSourceTrigger=PropertyChanged}"
                   AcceptsReturn="True" TextWrapping="Wrap" Height="190"
                   VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
          <Grid>
            <TextBlock Text="{Binding ComposeLengthLabel}" Style="{StaticResource CaptionText}" />
            <Button Style="{StaticResource GhostButton}" Content="从剪贴板粘贴"
                    Command="{Binding PasteClipboardCommand}" HorizontalAlignment="Right" />
          </Grid>
          <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource SecondaryButton}" Content="取消" Height="40" Margin="0,0,6,0"
                    Command="{Binding CloseComposeCommand}" />
            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="发送" Height="40"
                    Margin="6,0,0,0" Command="{Binding ConfirmComposeCommand}" />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.RowSpan="2" Panel.ZIndex="84" Background="#B3050710"
          Visibility="{Binding IsShareDialogOpen, Converter={StaticResource BoolToVis}}">
      <Border Width="560" CornerRadius="24" Background="#121725" BorderBrush="#2B344F"
              BorderThickness="1" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center"
              Effect="{StaticResource CardShadow}">
        <Grid>
          <StackPanel Visibility="{Binding HasCreatedShare, Converter={StaticResource InverseBoolToVis}}">
            <Grid>
              <StackPanel>
                <TextBlock Text="{Binding ShareDialogTitle}" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="链接可在浏览器中直接访问，无需安装 Lumen。" Style="{StaticResource MutedText}"
                           Margin="0,4,0,0" />
              </StackPanel>
              <Button Style="{StaticResource IconButton}" Content="&#xE8BB;"
                      Command="{Binding CloseShareDialogCommand}" HorizontalAlignment="Right" />
            </Grid>
            <Border Style="{StaticResource SoftCard}" Margin="0,18,0,14" Padding="14">
              <StackPanel>
                <TextBlock Text="分享内容" Style="{StaticResource FieldLabel}" />
                <TextBlock Text="{Binding ShareTargetLabel}" Style="{StaticResource CaptionText}"
                           FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <TextBlock Text="名称" Style="{StaticResource FieldLabel}" />
            <TextBox Style="{StaticResource DarkTextBox}" Margin="0,0,0,13"
                     Text="{Binding ShareName, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Visibility="{Binding ShareIsText, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="分享文字" Style="{StaticResource FieldLabel}" />
              <TextBox Style="{StaticResource DarkTextBox}" Margin="0,0,0,13" Height="120"
                       Text="{Binding ShareText, UpdateSourceTrigger=PropertyChanged}"
                       AcceptsReturn="True" TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
            </StackPanel>
            <Grid Margin="0,0,0,13">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="有效期（小时）" Style="{StaticResource FieldLabel}" />
                <TextBox Style="{StaticResource DarkTextBox}"
                         Text="{Binding ShareExpiryHours, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="下载次数上限（0 为不限）" Style="{StaticResource FieldLabel}" />
                <TextBox Style="{StaticResource DarkTextBox}"
                         Text="{Binding ShareMaxDownloads, UpdateSourceTrigger=PropertyChanged}" />
              </StackPanel>
            </Grid>
            <TextBlock Text="访问密码（可选）" Style="{StaticResource FieldLabel}" />
            <PasswordBox Style="{StaticResource DarkPasswordBox}"
                         infra:PasswordBoxHelper.Monitor="True"
                         infra:PasswordBoxHelper.Password="{Binding SharePassword, Mode=TwoWay}" />
            <TextBlock Text="分享内容会保存到服务器；到期后链接失效。密码至少 4 位。"
                       Style="{StaticResource FieldHint}" />
            <Grid Margin="0,20,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button Style="{StaticResource SecondaryButton}" Content="取消" Height="40" Margin="0,0,6,0"
                      Command="{Binding CloseShareDialogCommand}" />
              <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Height="40" Margin="6,0,0,0"
                      Command="{Binding ConfirmShareCommand}" IsEnabled="{Binding IsNotCreatingShare}">
                <TextBlock Text="创建分享链接" Foreground="#0B0D14" />
              </Button>
            </Grid>
          </StackPanel>
          <StackPanel Visibility="{Binding HasCreatedShare, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center">
              <Border Width="62" Height="62" CornerRadius="20" Background="#182B28">
                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE73E;" FontSize="25"
                           Foreground="#64E0C8" />
              </Border>
              <TextBlock Text="分享链接已创建" Style="{StaticResource SectionTitle}" FontSize="20"
                         Margin="0,14,0,0" HorizontalAlignment="Center" />
              <TextBlock Text="链接已自动复制到剪贴板。" Style="{StaticResource MutedText}"
                         Margin="0,5,0,0" HorizontalAlignment="Center" />
            </StackPanel>
            <Border Style="{StaticResource SoftCard}" Margin="0,20,0,0">
              <TextBox Text="{Binding CreatedShare.Url, Mode=OneWay}" IsReadOnly="True"
                       Background="Transparent" BorderThickness="0" Foreground="#D6DAE9"
                       FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="Wrap"
                       Padding="0" />
            </Border>
            <Grid Margin="0,16,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button Style="{StaticResource SecondaryButton}" Content="复制链接" Height="40" Margin="0,0,5,0"
                      Command="{Binding CopyCreatedShareCommand}" />
              <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="打开网页" Height="40"
                      Margin="5,0,5,0" Command="{Binding OpenShareUrlCommand}"
                      CommandParameter="{Binding CreatedShare}" />
              <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="完成" Height="40"
                      Margin="5,0,0,0" Command="{Binding CloseShareDialogCommand}" />
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.RowSpan="2" Panel.ZIndex="86" Background="#7A02040A"
          Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}">
      <Border Width="550" HorizontalAlignment="Right" Background="#0F1320"
              BorderBrush="#2A3248" BorderThickness="1,0,0,0" Effect="{StaticResource CardShadow}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid Margin="24,20,20,16">
            <StackPanel>
              <TextBlock Text="传输详情" Style="{StaticResource SectionTitle}" FontSize="18" />
              <TextBlock Text="{Binding SelectedTransfer.FullTimeLabel}" Style="{StaticResource CaptionText}"
                         Margin="0,4,0,0" />
            </StackPanel>
            <Button Style="{StaticResource IconButton}" Content="&#xE8BB;"
                    Command="{Binding CloseDetailCommand}" HorizontalAlignment="Right" />
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,0,24,20">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="56" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="52" Height="52" CornerRadius="16" Background="#1B2236">
                  <TextBlock Style="{StaticResource IconGlyph}" Text="{Binding SelectedTransfer.KindGlyph}"
                             FontSize="21" Foreground="#B4A9FF" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,1,10,0">
                  <TextBlock Text="{Binding SelectedTransfer.Name}" FontSize="14.5" FontWeight="SemiBold"
                             TextWrapping="Wrap" />
                  <TextBlock Text="{Binding SelectedTransfer.PeerLabel, StringFormat='与 {0}'}"
                             Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                </StackPanel>
                <Border Grid.Column="2" Style="{StaticResource StatusPill}" VerticalAlignment="Top">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="5" Height="5" Margin="0,0,6,0"
                             Fill="{Binding SelectedTransfer.StatusColor, Converter={StaticResource StringToBrush}}" />
                    <TextBlock Text="{Binding SelectedTransfer.StatusLabel}" FontSize="9.5"
                               Foreground="{Binding SelectedTransfer.StatusColor, Converter={StaticResource StringToBrush}}" />
                  </StackPanel>
                </Border>
              </Grid>
              <Image Source="{Binding SelectedTransfer.LocalPath, Converter={StaticResource PathToImage}}"
                     MaxHeight="280" Stretch="Uniform" Margin="0,18,0,0"
                     Visibility="{Binding SelectedTransfer.IsImage, Converter={StaticResource BoolToVis}}" />
              <Border Style="{StaticResource SoftCard}" Margin="0,18,0,0">
                <StackPanel>
                  <Grid>
                    <TextBlock Text="{Binding SelectedTransfer.TransferredLabel}" FontSize="10.5"
                               Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{Binding SelectedTransfer.ProgressText}" FontSize="10.5"
                               Foreground="{StaticResource TealBrush}" HorizontalAlignment="Right" />
                  </Grid>
                  <ProgressBar Style="{StaticResource ProgressTrack}" Margin="0,9,0,0" Height="6"
                               Value="{Binding SelectedTransfer.ProgressPercent, Mode=OneWay}" Maximum="100" />
                  <Grid Margin="0,9,0,0">
                    <TextBlock Text="{Binding SelectedTransfer.SpeedLabel}" Style="{StaticResource CaptionText}" />
                    <TextBlock Text="{Binding SelectedTransfer.ChunkLabel}" Style="{StaticResource CaptionText}"
                               HorizontalAlignment="Right" />
                  </Grid>
                </StackPanel>
              </Border>
              <TextBlock Text="连接与协议" Style="{StaticResource FieldLabel}" Margin="0,20,0,8" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource SoftCard}">
                  <StackPanel>
                    <TextBlock Text="传输路线" Style="{StaticResource MetricLabel}" />
                    <TextBlock Text="{Binding SelectedTransfer.RouteLabel}" Style="{StaticResource DetailValue}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedTransfer.AddressLabel}" Style="{StaticResource CaptionText}"
                               Margin="0,4,0,0" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource SoftCard}">
                  <StackPanel>
                    <TextBlock Text="地址族" Style="{StaticResource MetricLabel}" />
                    <TextBlock Text="{Binding SelectedTransfer.IpLabel}" Style="{StaticResource DetailValue}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedTransfer.DirectionLabel}" Style="{StaticResource CaptionText}"
                               Margin="0,4,0,0" />
                  </StackPanel>
                </Border>
              </Grid>
              <TextBlock Text="传输参数" Style="{StaticResource FieldLabel}" Margin="0,20,0,8" />
              <Border Style="{StaticResource SoftCard}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="文件大小" Style="{StaticResource MetricLabel}" />
                    <TextBlock Text="{Binding SelectedTransfer.SizeLabel}" Style="{StaticResource DetailValue}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="0,0,0,12">
                    <TextBlock Text="分块大小" Style="{StaticResource MetricLabel}" />
                    <TextBlock Text="{Binding SelectedTransfer.ChunkLabel}" Style="{StaticResource DetailValue}" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <TextBlock Text="完成分块" Style="{StaticResource MetricLabel}" />
                    <TextBlock Style="{StaticResource DetailValue}">
                      <Run Text="{Binding SelectedTransfer.CompletedChunks, Mode=OneWay}" /><Run Text=" / " />
                      <Run Text="{Binding SelectedTransfer.TotalChunks, Mode=OneWay}" />
                    </TextBlock>
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                    <TextBlock Text="当前速度" Style="{StaticResource MetricLabel}" />
                    <TextBlock Text="{Binding SelectedTransfer.SpeedLabel}" Style="{StaticResource DetailValue}" />
                  </StackPanel>
                  <StackPanel Grid.Row="2" Margin="0,0,0,12">
                    <TextBlock Text="开始时间" Style="{StaticResource MetricLabel}" />
                    <TextBlock Text="{Binding SelectedTransfer.FullTimeLabel}" Style="{StaticResource DetailValue}" />
                  </StackPanel>
                  <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,12">
                    <TextBlock Text="完成时间" Style="{StaticResource MetricLabel}" />
                    <TextBlock Text="{Binding SelectedTransfer.CompletedTimeLabel}" Style="{StaticResource DetailValue}" />
                  </StackPanel>
                  <StackPanel Grid.Row="3">
                    <TextBlock Text="最近更新" Style="{StaticResource MetricLabel}" />
                    <TextBlock Text="{Binding SelectedTransfer.UpdatedTimeLabel}" Style="{StaticResource DetailValue}"
                               FontSize="10.5" />
                  </StackPanel>
                  <StackPanel Grid.Row="3" Grid.Column="1">
                    <TextBlock Text="SHA-256" Style="{StaticResource MetricLabel}" />
                    <TextBlock Text="{Binding SelectedTransfer.HashShort}" Style="{StaticResource DetailValue}"
                               FontFamily="{StaticResource MonoFont}" FontSize="10" />
                  </StackPanel>
                </Grid>
              </Border>
              <TextBlock Text="本地保存" Style="{StaticResource FieldLabel}" Margin="0,20,0,8" />
              <TextBlock Text="{Binding SelectedTransfer.LocalPathLabel}" Style="{StaticResource CaptionText}"
                         FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" />
              <StackPanel Visibility="{Binding SelectedTransfer.IsText, Converter={StaticResource BoolToVis}}"
                          Margin="0,18,0,0">
                <TextBlock Text="文字内容" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource SoftCard}" MaxHeight="220">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding SelectedTransfer.TextContent}" TextWrapping="Wrap"
                               FontFamily="{StaticResource MonoFont}" FontSize="11" />
                  </ScrollViewer>
                </Border>
              </StackPanel>
              <TextBlock Text="{Binding SelectedTransfer.ErrorLabel}" Foreground="{StaticResource DangerBrush}"
                         FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0"
                         Visibility="{Binding SelectedTransfer.ErrorLabel, Converter={StaticResource EmptyStringToVis}}" />
              <Grid Margin="0,22,0,9">
                <TextBlock Text="事件时间线" Style="{StaticResource SectionTitle}" FontSize="14" />
                <TextBlock Text="{Binding SelectedTransfer.EventCount, StringFormat='{}{0} 个事件'}"
                           Style="{StaticResource CaptionText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
              <ItemsControl ItemsSource="{Binding SelectedTransfer.Events}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid>
                        <Border Width="7" Height="7" CornerRadius="4" Background="#6C5FE0"
                                VerticalAlignment="Top" Margin="0,5,0,0" />
                        <Border Width="1" Background="#252D42" VerticalAlignment="Stretch" Margin="3,14,0,0" />
                      </Grid>
                      <StackPanel Grid.Column="1" Margin="7,0,0,0">
                        <Grid>
                          <TextBlock Text="{Binding TypeLabel}" FontSize="11" FontWeight="SemiBold"
                                     Foreground="#C8CFDF" />
                          <TextBlock Text="{Binding TimeLabel}" Style="{StaticResource CaptionText}"
                                     HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
          <Border Grid.Row="2" Background="#0E121D" BorderBrush="#232B3F" BorderThickness="0,1,0,0"
                  Padding="24,14">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource PrimaryButton}" Content="打开文件" Margin="0,0,7,0"
                      Command="{Binding OpenFileCommand}" CommandParameter="{Binding SelectedTransfer}"
                      IsEnabled="{Binding SelectedTransfer.CanOpen}" />
              <Button Style="{StaticResource SecondaryButton}" Content="打开位置"
                      Command="{Binding OpenFolderCommand}" CommandParameter="{Binding SelectedTransfer}" />
              <Button Style="{StaticResource GhostButton}" Content="创建分享" Margin="7,0,0,0"
                      Command="{Binding ShareTransferCommand}" CommandParameter="{Binding SelectedTransfer}"
                      IsEnabled="{Binding SelectedTransfer.CanShare}" />
              <Button Style="{StaticResource DangerGhostButton}" Content="取消传输"
                      Command="{Binding CancelTransferCommand}" CommandParameter="{Binding SelectedTransfer}"
                      IsEnabled="{Binding SelectedTransfer.CanCancel}" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.RowSpan="2" Panel.ZIndex="200" HorizontalAlignment="Center" VerticalAlignment="Bottom"
            Margin="0,0,0,26" Background="#E61B2132" BorderBrush="#343E59" BorderThickness="1"
            CornerRadius="12" Padding="18,11"
            Visibility="{Binding ToastVisible, Converter={StaticResource BoolToVis}}">
      <StackPanel Orientation="Horizontal">
        <Ellipse Width="6" Height="6" Margin="0,0,9,0"
                 Fill="{Binding ToastColor, Converter={StaticResource StringToBrush}}" />
        <TextBlock Text="{Binding ToastMessage}" FontSize="11.5" MaxWidth="560" TextWrapping="Wrap"
                   Foreground="{Binding ToastColor, Converter={StaticResource StringToBrush}}" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
