<Application x:Class="Lumen.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Lumen.Windows.Converters">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
      <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
      <conv:NullToVisibilityConverter x:Key="NullToVis" />
      <conv:EmptyStringToVisibilityConverter x:Key="EmptyStringToVis" />
      <conv:StringEqualsVisibilityConverter x:Key="StringEqualsToVis" />
      <conv:StringEqualsBoolConverter x:Key="StringEqualsToBool" />
      <conv:StringToBrushConverter x:Key="StringToBrush" />
      <conv:PathToImageConverter x:Key="PathToImage" />
      <conv:CountToVisibilityConverter x:Key="CountToVis" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
