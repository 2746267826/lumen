<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="BgColor">#0A0C14</Color>
  <Color x:Key="SidebarColor">#0D101A</Color>
  <Color x:Key="SurfaceColor">#111522</Color>
  <Color x:Key="SurfaceAltColor">#161B2B</Color>
  <Color x:Key="ElevatedColor">#1A2031</Color>
  <Color x:Key="BorderColor">#252C40</Color>
  <Color x:Key="BorderSoftColor">#1C2233</Color>
  <Color x:Key="TextColor">#F4F6FF</Color>
  <Color x:Key="MutedColor">#909AB3</Color>
  <Color x:Key="DimColor">#656F88</Color>
  <Color x:Key="AccentColor">#8D80FF</Color>
  <Color x:Key="AccentSoftColor">#28254C</Color>
  <Color x:Key="TealColor">#55DFC9</Color>
  <Color x:Key="GreenColor">#55DCA8</Color>
  <Color x:Key="WarningColor">#F1BD69</Color>
  <Color x:Key="DangerColor">#FF8795</Color>

  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
  <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
  <SolidColorBrush x:Key="ElevatedBrush" Color="{StaticResource ElevatedColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="BorderSoftBrush" Color="{StaticResource BorderSoftColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
  <SolidColorBrush x:Key="DimBrush" Color="{StaticResource DimColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
  <SolidColorBrush x:Key="TealBrush" Color="{StaticResource TealColor}" />
  <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource GreenColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

  <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#AEA5FF" Offset="0" />
    <GradientStop Color="#8476FF" Offset="0.52" />
    <GradientStop Color="#4EDBC7" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="AvatarGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#8C7DFF" Offset="0" />
    <GradientStop Color="#4D9BFF" Offset="0.55" />
    <GradientStop Color="#4FE0C8" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#202140" Offset="0" />
    <GradientStop Color="#161B2C" Offset="0.55" />
    <GradientStop Color="#112625" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="LineGradient" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#8D80FF" Offset="0" />
    <GradientStop Color="#55DFC9" Offset="1" />
  </LinearGradientBrush>

  <DropShadowEffect x:Key="CardShadow" BlurRadius="32" ShadowDepth="8" Opacity="0.22" Color="#000000" />
  <DropShadowEffect x:Key="AccentGlow" BlurRadius="28" ShadowDepth="0" Opacity="0.34" Color="#7C6DFF" />

  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, sans-serif</FontFamily>
  <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI, sans-serif</FontFamily>
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Microsoft YaHei UI, monospace</FontFamily>

  <Style TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>

  <Style x:Key="DisplayTitle" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>

  <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>

  <Style x:Key="CardTitle" TargetType="{x:Type TextBlock}">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>

  <Style x:Key="MutedText" TargetType="{x:Type TextBlock}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="CaptionText" TargetType="{x:Type TextBlock}">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="MetricValue" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>

  <Style x:Key="IconGlyph" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <Style x:Key="Card" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="20" />
  </Style>

  <Style x:Key="SoftCard" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="#101420" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="15" />
  </Style>

  <Style x:Key="Chip" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="#161C2C" />
    <Setter Property="BorderBrush" Value="#262E43" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="Divider" TargetType="{x:Type Border}">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{StaticResource BorderSoftBrush}" />
    <Setter Property="Margin" Value="0,14" />
  </Style>

  <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="#0B0D14" />
    <Setter Property="Background" Value="{StaticResource AccentGradient}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  CornerRadius="11"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Opacity" Value="0.9" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Opacity" Value="0.78" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.35" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Background" Value="#1C2234" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <Style x:Key="GhostButton" TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  CornerRadius="10"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="#1A2030" />
              <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="#242B40" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.35" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DangerGhostButton" TargetType="{x:Type Button}" BasedOn="{StaticResource GhostButton}">
    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
  </Style>

  <Style x:Key="IconButton" TargetType="{x:Type Button}">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  CornerRadius="8">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="#20273A" />
              <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="#2A3248" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.3" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="WindowButton" TargetType="{x:Type Button}" BasedOn="{StaticResource IconButton}">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="30" />
    <Setter Property="FontSize" Value="10" />
  </Style>

  <Style x:Key="NavItem" TargetType="{x:Type RadioButton}">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <Grid>
            <Border x:Name="Root" Background="Transparent" CornerRadius="12" Height="44" />
            <Border x:Name="Indicator"
                    Width="3" Height="20" CornerRadius="2"
                    Background="{StaticResource AccentGradient}"
                    HorizontalAlignment="Left" Margin="4,0,0,0"
                    Opacity="0" />
            <ContentPresenter Margin="17,0,12,0"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Stretch" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="#141927" />
              <Setter Property="Foreground" Value="#D3D8E9" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Root" Property="Background" Value="#1A1D32" />
              <Setter TargetName="Indicator" Property="Opacity" Value="1" />
              <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FilterChip" TargetType="{x:Type RadioButton}">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="13,7" />
    <Setter Property="Margin" Value="0,0,7,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <Border x:Name="Root"
                  Background="#121725"
                  BorderBrush="#22293C"
                  BorderThickness="1"
                  CornerRadius="9"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="#3A4360" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Root" Property="Background" Value="#252047" />
              <Setter TargetName="Root" Property="BorderBrush" Value="#6C5FE0" />
              <Setter Property="Foreground" Value="#D9D4FF" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DarkTextBox" TargetType="{x:Type TextBox}">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
    <Setter Property="Background" Value="#0E121C" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="SelectionBrush" Value="#6458BF" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10">
            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="{TemplateBinding Padding}"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Hidden" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="#7567E8" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DarkPasswordBox" TargetType="{x:Type PasswordBox}">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
    <Setter Property="Background" Value="#0E121C" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type PasswordBox}">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10">
            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="{TemplateBinding Padding}"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Hidden" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="#7567E8" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type ComboBox}">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Background" Value="#0E121C" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Height" Value="38" />
  </Style>

  <Style x:Key="ProgressTrack" TargetType="{x:Type ProgressBar}">
    <Setter Property="Height" Value="5" />
    <Setter Property="Background" Value="#252C40" />
    <Setter Property="Foreground" Value="{StaticResource AccentGradient}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ProgressBar}">
          <Grid x:Name="TemplateRoot" SnapsToDevicePixels="True">
            <Border Background="{TemplateBinding Background}" CornerRadius="3" />
            <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left">
              <Border Background="{TemplateBinding Foreground}" CornerRadius="3" />
            </Decorator>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type ScrollBar}">
    <Setter Property="Width" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollBar}">
          <Grid Background="Transparent" Width="8">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                      <Border Background="#2D354A" CornerRadius="4" Margin="2,2" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Height" Value="0" />
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Visibility" Value="Collapsed" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="{x:Type ToolTip}">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Background" Value="#20263A" />
    <Setter Property="BorderBrush" Value="#333D58" />
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="FontSize" Value="11.5" />
  </Style>

  <Style x:Key="WindowButtonClose" TargetType="{x:Type Button}" BasedOn="{StaticResource WindowButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="Root" Background="Transparent" CornerRadius="0">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="#D83B4E" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FlatCloseButton" TargetType="{x:Type Button}" BasedOn="{StaticResource IconButton}">
    <Setter Property="FontSize" Value="12" />
  </Style>
</ResourceDictionary>
