{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Lumen": {
    "DataDir": "./data",
    "PublicUrl": "",
    "AllowRegistration": true,
    "SessionDays": 90,
    "RetentionDays": 14,
    "MaxShareBytes": 21474836480,
